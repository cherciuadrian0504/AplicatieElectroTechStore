@model IEnumerable<ElectroTechStore.Models.Product>

@{
    ViewData["Title"] = "Administrare Produse";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Administrare Catalog Produse</h2>
        <p class="text-muted mb-0">Gestionează piesele PC, plăcile embedded, stocurile și furnizorii</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Adaugă Produs Nou
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Produs</th>
                        <th>Categorie</th>
                        <th>Furnizor</th>
                        <th>Livrare</th>
                        <th class="text-end">Preț</th>
                        <th class="text-center">Stoc</th>
                        <th class="text-end pe-4">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="rounded me-3 border" style="width: 48px; height: 48px; object-fit: contain; background: #fff;" />
                                    }
                                    <div>
                                        <div class="fw-semibold">@item.Name</div>
                                        <small class="text-muted">ID: #@item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Category?.Name</span>
                            </td>
                            <td>@item.Supplier</td>
                            <td><small class="text-muted">@item.DeliveryMethod</small></td>
                            <td class="text-end fw-bold text-primary">@item.Price.ToString("0.00") RON</td>
                            <td class="text-center">
                                @if (item.Stock > 5)
                                {
                                    <span class="badge bg-success">În stoc (@item.Stock)</span>
                                }
                                else if (item.Stock > 0)
                                {
                                    <span class="badge bg-warning text-dark">Stoc limitat (@item.Stock)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Stoc epuizat (0)</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editează</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Șterge</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>