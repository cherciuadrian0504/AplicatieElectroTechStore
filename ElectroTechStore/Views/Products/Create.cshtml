@model ElectroTechStore.Models.Product

@{
    ViewData["Title"] = "Adaugă Produs";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Adaugă Produs Nou în Catalog</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ex: Placă de dezvoltare ESP32 Wi-Fi + Bluetooth" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Alege Categoria --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" type="number" class="form-control" placeholder="Ex: 15" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Supplier" class="form-label fw-semibold"></label>
                            <input asp-for="Supplier" class="form-control" placeholder="Ex: Espressif / DigiKey" />
                            <span asp-validation-for="Supplier" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DeliveryMethod" class="form-label fw-semibold"></label>
                            <select asp-for="DeliveryMethod" class="form-select">
                                <option value="">-- Selectează Livrarea --</option>
                                <option value="Easybox / Curier Rapid">Easybox / Curier Rapid</option>
                                <option value="Curier Rapid (24h)">Curier Rapid (24h)</option>
                                <option value="Easybox / Ridicare Showroom">Easybox / Ridicare Showroom</option>
                                <option value="Livrare Standard Furnizor">Livrare Standard Furnizor</option>
                            </select>
                            <span asp-validation-for="DeliveryMethod" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://exemplu.ro/imagine.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descrierea detaliată a produsului și a utilizărilor..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Specifications" class="form-label fw-semibold"></label>
                            <textarea asp-for="Specifications" class="form-control" rows="3" placeholder="Separă specificațiile cu | (Ex: Frecvență: 240MHz | Flash: 4MB | Tensiune: 3.3V)"></textarea>
                            <span asp-validation-for="Specifications" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-4 mt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Înapoi la listă</a>
                        <button type="submit" class="btn btn-primary">Adaugă Produsul</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}