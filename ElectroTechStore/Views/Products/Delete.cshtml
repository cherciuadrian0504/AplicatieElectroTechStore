@model ElectroTechStore.Models.Product

@{
    ViewData["Title"] = "Șterge Produs";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Confirmare Ștergere Produs</h5>
            </div>
            <div class="card-body">
                <p class="mb-3">Ești sigur că vrei să ștergi definitiv produsul <strong>@Model.Name</strong>?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Categorie:</dt>
                    <dd class="col-sm-8">@Model.Category?.Name</dd>

                    <dt class="col-sm-4">Preț:</dt>
                    <dd class="col-sm-8 fw-bold text-danger">@Model.Price.ToString("0.00") RON</dd>

                    <dt class="col-sm-4">Stoc curent:</dt>
                    <dd class="col-sm-8">@Model.Stock buc.</dd>

                    <dt class="col-sm-4">Furnizor:</dt>
                    <dd class="col-sm-8">@Model.Supplier</dd>

                    <dt class="col-sm-4">Livrare:</dt>
                    <dd class="col-sm-8">@Model.DeliveryMethod</dd>
                </dl>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Renunță</a>
                    <button type="submit" class="btn btn-danger">Confirmă Ștergerea</button>
                </form>
            </div>
        </div>
    </div>
</div>