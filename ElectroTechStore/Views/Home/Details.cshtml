@model ElectroTechStore.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var specsList = (Model.Specifications ?? "")
        .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var related = ViewBag.RelatedProducts as List<ElectroTechStore.Models.Product> ?? new List<ElectroTechStore.Models.Product>();
}

<!-- Breadcrumb Navigare -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Acasă</a></li>
        <li class="breadcrumb-item">
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none">
                @Model.Category?.Name
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h3 class="fw-bold mb-3">@Model.Name</h3>

        <div class="row g-4">
            <!-- Coloana 1: Imagine Produs -->
            <div class="col-lg-5 text-center border-end">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid p-3" style="max-height: 340px; object-fit: contain;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light rounded" style="height: 300px;">
                        <span class="text-muted">Imagine indisponibilă</span>
                    </div>
                }
            </div>

            <!-- Coloana 2: Informații Principale & Sumar Specificații -->
            <div class="col-lg-4">
                <div class="mb-3">
                    <span class="badge bg-primary me-1">@Model.Category?.Name</span>
                    <span class="badge bg-secondary">Cod produs: #@Model.Id</span>
                </div>

                <p class="mb-2"><strong>Furnizor / Brand:</strong> @Model.Supplier</p>
                <p class="mb-3"><strong>Modalitate de livrare:</strong> <span class="text-primary fw-semibold">@Model.DeliveryMethod</span></p>

                <h6 class="fw-bold border-bottom pb-2">Descriere Produs</h6>
                <p class="text-muted">@Model.Description</p>

                <h6 class="fw-bold border-bottom pb-2 mt-3">Specificații cheie</h6>
                <ul class="small ps-3 mb-0">
                    @foreach (var spec in specsList)
                    {
                        <li class="mb-1">@spec</li>
                    }
                </ul>
            </div>

            <!-- Coloana 3: Caseta de Preț și Stoc (Buy Box stil eMAG) -->
            <div class="col-lg-3">
                <div class="card bg-light border-0 shadow-sm">
                    <div class="card-body">
                        <div class="fs-2 fw-bold text-danger mb-2">
                            @Model.Price.ToString("0.00") <span class="fs-5">RON</span>
                        </div>

                        <div class="mb-3">
                            @if (Model.Stock > 5)
                            {
                                <span class="badge bg-success fs-6">În stoc (@Model.Stock buc.)</span>
                            }
                            else if (Model.Stock > 0)
                            {
                                <span class="badge bg-warning text-dark fs-6">Stoc limitat (@Model.Stock buc.)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Stoc epuizat</span>
                            }
                        </div>

                        <hr />

                        <div class="small mb-3">
                            <div class="mb-2">
                                <strong>Vândut și livrat de:</strong><br />
                                <span class="text-dark">@Model.Supplier</span>
                            </div>
                            <div>
                                <strong>Opțiuni livrare:</strong><br />
                                <span class="text-success fw-semibold">@Model.DeliveryMethod</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-primary">
                                Mai multe din @Model.Category?.Name
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <hr class="my-2" />
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold">
                                    Editează Produs (Admin)
                                </a>
                                <a asp-controller="Products" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                                    Șterge Produs
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabelul Complet de Specificații Tehnice -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Specificații Tehnice Complete</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <tbody>
                <tr>
                    <th class="ps-4 w-25 text-muted">Denumire</th>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <th class="ps-4 text-muted">Categorie</th>
                    <td>@Model.Category?.Name</td>
                </tr>
                <tr>
                    <th class="ps-4 text-muted">Furnizor</th>
                    <td>@Model.Supplier</td>
                </tr>
                <tr>
                    <th class="ps-4 text-muted">Modalitate Livrare</th>
                    <td>@Model.DeliveryMethod</td>
                </tr>
                @foreach (var spec in specsList)
                {
                    var parts = spec.Split(':', 2);
                    if (parts.Length == 2)
                    {
                        <tr>
                            <th class="ps-4 text-muted">@parts[0].Trim()</th>
                            <td>@parts[1].Trim()</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th class="ps-4 text-muted">Caracteristică</th>
                            <td>@spec</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (related.Any())
{
    <h5 class="fw-bold mb-3">Produse similare din aceeași categorie</h5>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var item in related)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none text-dark d-block mb-1">
                                @item.Name
                            </a>
                            <span class="text-danger fw-bold">@item.Price.ToString("0.00") RON</span>
                        </div>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Vezi</a>
                    </div>
                </div>
            </div>
        }
    </div>
}